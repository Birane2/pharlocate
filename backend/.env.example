# Copiez ce fichier vers .env puis remplacez les valeurs.
# Django ne charge pas .env.example automatiquement.
EMAIL_BACKEND_MODE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=votre_adresse@gmail.com
EMAIL_HOST_PASSWORD=mot_de_passe_application_gmail
DEFAULT_FROM_EMAIL=PharmaLocate <votre_adresse@gmail.com>
OTP_DEBUG_PRINT=False
