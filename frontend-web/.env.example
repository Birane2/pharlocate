# Copiez ce fichier vers .env puis remplacez les valeurs.

# URL du backend Django (sans slash final)
VITE_API_URL=http://127.0.0.1:8000

# Clé API Google Maps (obligatoire pour le picker de localisation)
# Activez ces APIs dans la Google Cloud Console :
#   - Maps JavaScript API
#   - Places API
#   - Geocoding API
# https://console.cloud.google.com/apis/
VITE_GOOGLE_MAPS_API_KEY=votre_cle_google_maps_ici
